{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vinioccode.github.io/mlbot/schemas/run_manifest.schema.json",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "created_at",
    "workspace_path",
    "status",
    "publication_candidates",
    "build_failures",
    "diagnostics"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace_path": { "type": "string" },
    "status": { "type": "string", "enum": ["success", "partial_success", "failed"] },
    "publication_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "sku_scope", "topology", "build_status", "payloads", "errors"],
        "properties": {
          "group_id": { "type": "string" },
          "family_id": { "type": ["string", "null"] },
          "sku_scope": { "type": "array", "items": { "type": "string" } },
          "topology": { "type": ["string", "null"] },
          "build_status": {
            "type": "string",
            "enum": ["success", "partial_success", "failed", "skipped", "not_publishable"]
          },
          "payloads": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variant", "listing_type_id", "publishable"],
              "properties": {
                "variant": { "type": "string" },
                "payload_path": { "type": ["string", "null"] },
                "listing_type_id": { "type": "string" },
                "publishable": { "type": "boolean" },
                "artifact_source": { "type": ["string", "null"] },
                "created_at": { "type": ["string", "null"], "format": "date-time" },
                "block_reason": { "type": ["string", "null"] },
                "skip_reason": { "type": ["string", "null"] }
              }
            }
          },
          "errors": { "type": "array" }
        }
      }
    },
    "build_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "sku": { "type": ["string", "null"] },
          "group_id": { "type": ["string", "null"] },
          "family_id": { "type": ["string", "null"] },
          "stage": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] },
          "publishable": { "type": "boolean", "const": false }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    }
  }
}
